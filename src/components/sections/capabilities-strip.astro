---
const capabilities = [
  "Open-Pit Operations",
  "Underground Mining",
  "Mineral Processing",
  "Bulk Material Handling",
  "Remote Operations Centers",
]
---

<section class="border-b border-border py-10">
  <div class="mx-auto max-w-7xl px-6">
    <p class="text-center text-xs font-semibold tracking-widest text-muted-foreground uppercase">
      Built for every stage of the operation
    </p>
    <div
      class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4"
    >
      {
        capabilities.map((label) => (
          <span class="text-sm font-semibold tracking-wide text-foreground/60">
            {label}
          </span>
        ))
      }
    </div>
  </div>
</section>
