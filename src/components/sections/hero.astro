---
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { GridPattern } from "@/components/velora/grid-pattern"
import { Typewriter } from "@/components/velora/typewriter"
import { NumberTicker } from "@/components/velora/number-ticker"

const stats = [
  { value: 30, suffix: "%", label: "Avg. downtime reduction" },
  { value: 24, suffix: "/7", label: "Remote monitoring" },
  { value: 15, suffix: "+", label: "Years combined mining-tech experience" },
  { value: 99.9, suffix: "%", decimalPlaces: 1, label: "System uptime" },
]
---

<section id="top" class="relative overflow-hidden border-b border-border">
  <GridPattern
    className="mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,black,transparent)]"
  />

  <div class="relative mx-auto max-w-7xl px-6 py-24 sm:py-32">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
      <Badge
        variant="outline"
        className="border border-border px-3 py-1.5 text-muted-foreground"
      >
        Technology adapted for the mine site
      </Badge>

      <h1
        class="font-heading text-4xl font-bold tracking-tight text-balance uppercase sm:text-6xl"
      >
        We turn proven tech into
      </h1>

      <Typewriter
        client:load
        className="whitespace-nowrap text-xl font-bold text-primary sm:text-3xl"
        words={[
          "mine-ready systems",
          "predictive maintenance",
          "autonomous monitoring",
          "safety-grade compliance",
        ]}
      />

      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        MiningSMT adapts sensing, automation, and software from other
        industries into rugged, field-tested solutions built for open-pit,
        underground, and processing operations — deployed without disrupting
        the equipment you already run.
      </p>

      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <a href="#contact" class={buttonVariants({ size: "lg" })}>
          Book a site assessment
        </a>
        <a
          href="#solutions"
          class={buttonVariants({ variant: "outline", size: "lg" })}
        >
          View solutions
        </a>
      </div>

      <div
        class="mt-10 grid w-full grid-cols-2 gap-6 border-t border-border pt-8 sm:grid-cols-4"
      >
        {
          stats.map((stat) => (
            <div class="flex flex-col items-center gap-1">
              <span class="font-heading text-2xl font-bold text-primary sm:text-3xl">
                <NumberTicker
                  client:visible
                  value={stat.value}
                  suffix={stat.suffix}
                  decimalPlaces={stat.decimalPlaces ?? 0}
                />
              </span>
              <span class="text-xs tracking-wide text-muted-foreground uppercase">
                {stat.label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
