---
import { ThemeToggle } from "@/components/theme-toggle"
import { buttonVariants } from "@/components/ui/button"

const navLinks = [
  { href: "#solutions", label: "Solutions" },
  { href: "#process", label: "Process" },
  { href: "#testimonials", label: "Testimonials" },
  { href: "#faq", label: "FAQ" },
]
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6"
  >
    <a
      href="#top"
      class="font-heading text-lg font-bold tracking-widest uppercase"
    >
      Mining<span class="text-primary">SMT</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs font-semibold tracking-widest text-muted-foreground uppercase transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <a href="#contact" class={buttonVariants({ className: "hidden sm:inline-flex" })}>
        Get in touch
      </a>

      <details class="group relative lg:hidden">
        <summary
          aria-label="Toggle menu"
          class="flex size-10 cursor-pointer list-none items-center justify-center border border-border [&::-webkit-details-marker]:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-open:hidden"
          >
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden group-open:block"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </summary>
        <nav
          class="absolute top-full right-0 mt-2 flex w-56 flex-col gap-1 border border-border bg-popover p-2 shadow-sm"
        >
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="px-3 py-2 text-xs font-semibold tracking-widest text-muted-foreground uppercase transition-colors hover:bg-muted hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href="#contact"
            class="px-3 py-2 text-xs font-semibold tracking-widest text-primary uppercase transition-colors hover:bg-muted"
          >
            Get in touch
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
